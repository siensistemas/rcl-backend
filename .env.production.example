# Django
DJANGO_ENV=production
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=www.siensistemas.com,siensistemas.com,localhost

# Backend servido bajo subruta (www.siensistemas.com/busca_me/)
SCRIPT_NAME=/busca_me

# Database (misma config que docker-compose.prod.yml)
DB_NAME=busca_me_db
DB_USER=busca_me_user
DB_PASSWORD=change-me-strong-db-password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Frontend
FRONTEND_URL=https://www.siensistemas.com

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# AWS S3 / Cloudflare R2 / Backblaze B2 (media local -> dejar False)
USE_S3=False

# CORS - origenes web permitidos
CORS_ALLOWED_ORIGINS=https://www.siensistemas.com,https://siensistemas.com

# CSRF - origenes confiables para POST seguro
CSRF_TRUSTED_ORIGINS=https://www.siensistemas.com,https://siensistemas.com

# Superusuario inicial (se crea en entrypoint si no existe)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@siensistemas.com
ADMIN_PASSWORD=change-me-strong-admin-password